# ── Detection thresholds (REQUIRED) ──────────────────────────
# Hysteresis entry/exit for Threads_running.
# exit MUST be strictly less than entry.
THREADS_ENTRY=40
THREADS_EXIT=20

# ── Patience knobs (polls, optional — documented defaults) ──
# N : Sustained bottleneck — polls above exit before auto-heal (floor: 1)
# M : Heal cooldown — polls to wait after a KILL before next (floor: 1)
# K : Monitor blindness — failed polls before blindness alert (floor: 0)
# J : Attribution blindness — failed phase-two before alert (floor: 0)
# N=5
# M=10
# K=3
# J=5

# ── Database connection ─────────────────────────────────────
# Connects through MariaDB extra_port (3307) by default.
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=monitor
# DB_PASSWORD=
# DB_NAME=

# ── Poll timing ────────────────────────────────────────────
# Wall-clock gap between polls (fixed-delay, not fixed-rate).
# POLL_INTERVAL_SEC=1.0

# ── Auto-Heal ──────────────────────────────────────────────
# Set to true to enable automatic KILL QUERY execution.
# Default: false (alert-only mode).
# AUTO_HEAL=false

# ── Kill exclusion (allowlist) ──────────────────────────────
# Comma-separated user@host patterns. Host can use % wildcard.
# KILL_EXCLUSION=repl@%,app@10.0.0.5

# ── Telegram alerts ────────────────────────────────────────
# Leave both empty to disable alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_SEND_TIMEOUT_SEC=5
# BOT_POLL_INTERVAL_SEC=2.0
# STATUS_INTERVAL_SEC=3600

# ── Durable log ────────────────────────────────────────────
# Host-volume backed path (survives container restart).
# DURABLE_LOG_PATH=/var/log/monitor/monitor.jsonl
# LOG_MAX_SIZE_MB=50
# LOG_MAX_FILES=5
# LOG_RETENTION_DAYS=30

# ── Monitor identity ───────────────────────────────────────
# Used to prevent auto-heal from killing its own connection.
# MONITOR_USER=monitor
# MONITOR_HOST=127.0.0.1
